.DS_Store
node_modules/
dist/
*.log
.idea/
.vscode/
.turbo/

# Vendored @authio/node ships its pre-built dist/ so consumers don't need
# to npm-resolve the @authio scope from this repo. Un-ignore it.
!vendor/authio-node/dist/
!vendor/authio-node/dist/**

# Likewise the example's source-controlled bits stay out of dist/ — but
# we want the example tsconfig + package.json etc. The example's own
# .gitignore handles its node_modules + dist.
